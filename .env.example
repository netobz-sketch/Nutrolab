# Porta e pasta de dados (SQLite + uploads). Em Docker a pasta é /data.
PORT=8090
DATA_DIR=./data

# Segredo das sessões (obrigatório em produção). Gere com: openssl rand -hex 32
SESSION_SECRET=

# Primeiro administrador: criado só quando a tabela de usuários está vazia.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# IA (opcional). Sem chave, a leitura de PDF e a redação automática ficam desligadas
# e o lançamento manual + motor de regras continuam funcionando.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Hosts aceitos (vírgula). Vazio = qualquer host.
ALLOWED_HOSTS=
NODE_ENV=development

# URL pública (links de redefinição de senha)
APP_URL=http://localhost:8090
# E-mail para "Esqueci a senha" (opcional). Sem SMTP, o administrador gera o link em Configurações.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=NutroLab
