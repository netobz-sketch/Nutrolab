# Porta e pasta de dados (SQLite + uploads). Em Docker a pasta é /data.
PORT=8090
DATA_DIR=./data

# Segredo das sessões (obrigatório em produção). Gere com: openssl rand -hex 32
SESSION_SECRET=

# Primeiro administrador: criado só quando a tabela de usuários está vazia.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# IA (opcional). Sem chave, a leitura de PDF e a redação automática ficam desligadas
# e o lançamento manual + motor de regras continuam funcionando.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Hosts aceitos (vírgula). Vazio = qualquer host.
ALLOWED_HOSTS=
NODE_ENV=development

# URL pública (links de redefinição de senha)
APP_URL=http://localhost:8090
# E-mail para "Esqueci a senha" (opcional). Sem SMTP, o administrador gera o link em Configurações.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=NutroLab

# API de integração servidor a servidor (LN Evolution). Vazio = integração desligada
# (rotas /api/integration/* respondem 404). Gere com: openssl rand -hex 32
INTEGRATION_TOKEN=

# Endereço público do LN Evolution (https://…), para o link "prontuário" dos casos vindos da integração
# na tela /casos. Vazio = link oculto.
LN_EVOLUTION_PUBLIC_URL=

# Senha única (GoTrue do LN Medicina Integrada). Com as duas variáveis e GOTRUE_JWT_SECRET, o login por
# e-mail+senha é conferido no GoTrue (POST /auth/v1/token?grant_type=password). Recusa do GoTrue é definitiva;
# só com o GoTrue fora do ar o login local é usado. Login por CPF+conselho continua local.
# GOTRUE_ANON_KEY é a chave PÚBLICA (anon); nunca a service_role.
GOTRUE_URL=
GOTRUE_ANON_KEY=
# Endereço público do app LN Medicina Integrada. Com o login único ligado, "Trocar senha" e "Esqueci a senha"
# avisam que a senha é a central e linkam <url>/configuracoes e <url>/recuperar-senha. Vazia: aviso sem link.
# Também liga a passagem de sessão: POST /sso/callback só aceita Origin desta URL, GET /login?from=app vai
# para <url>/sso/exames, e a marca + "Início · LN Medicina Integrada" no menu levam a ela.
GOTRUE_PUBLIC_APP_URL=
