{
  "name": "nutrolab",
  "version": "0.1.0",
  "private": true,
  "description": "Análise de exames de nutrologia: regras do médico + leitura de PDF por IA, sempre como minuta para revisão médica.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsc --watch & node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"dist/test/**/*.test.js\"",
    "backup": "node --disable-warning=ExperimentalWarning dist/scripts/backup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
