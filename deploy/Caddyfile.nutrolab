# Bloco a acrescentar em /srv/clinica/Caddyfile. Aplicado por deploy/deploy-vps.sh.

{$NUTROLAB_HOST} {
	import security
	encode zstd gzip
	# API de integração (LN Evolution) só pela rede interna do Docker: nunca pela internet.
	@integ path /api/integration/*
	respond @integ 404
	reverse_proxy nutrolab:8090
}
